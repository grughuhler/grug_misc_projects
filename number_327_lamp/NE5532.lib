VC    3 53 DC 1.600
VE   54  4 DC 1.600
VLIM  7  8 DC 0
VLP  91  0 DC 38
VLN   0 92 DC 38
.MODEL DX D(IS=800.0E-18)
.MODEL JX PJF(BETA=1.250E-3 VTO=-1 BETA=1.250E-3)
.ENDS NE5532
